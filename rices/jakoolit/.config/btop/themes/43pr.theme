# Generated by 43pr theme.py from ~/.config/43pr/templates/btop.theme. Do not edit.
# Colors come from the shared semantic palette (presets or Matugen).

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="#0e0e0f"

# Main text color
theme[main_fg]="#e4e2e3"

# Title color for boxes
theme[title]="#e4e2e3"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c2c6d6"

# Background and foreground color for selected item in processes box
theme[selected_bg]="#2a2a2b"
theme[selected_fg]="#e4e2e3"

# Color of inactive/disabled text
theme[inactive_fg]="#474648"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c4c6d0"

# Box outline and divider line colors
theme[cpu_box]="#474648"
theme[mem_box]="#474648"
theme[net_box]="#474648"
theme[proc_box]="#474648"
theme[div_line]="#474648"

# Temperature graph colors
theme[temp_start]="#929092"
theme[temp_mid]="#ffb4ab"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#929092"
theme[cpu_mid]="#c8c6c7"
theme[cpu_end]="#c2c6d6"

# Mem/Disk free meter
theme[free_start]="#929092"
theme[free_mid]="#929092"
theme[free_end]="#bfc6dc"

# Mem/Disk cached meter
theme[cached_start]="#929092"
theme[cached_mid]="#929092"
theme[cached_end]="#c4c6d0"

# Mem/Disk available meter
theme[available_start]="#929092"
theme[available_mid]="#929092"
theme[available_end]="#c8c6c7"

# Mem/Disk used meter
theme[used_start]="#929092"
theme[used_mid]="#c8c6c7"
theme[used_end]="#c2c6d6"

# Download graph colors
theme[download_start]="#929092"
theme[download_mid]="#929092"
theme[download_end]="#c4c6d0"

# Upload graph colors
theme[upload_start]="#929092"
theme[upload_mid]="#929092"
theme[upload_end]="#c2c6d6"
