# Generated by 43pr theme.py from ~/.config/43pr/templates/btop.theme. Do not edit.
# Colors come from the shared semantic palette (presets or Matugen).

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="#0d0e0d"

# Main text color
theme[main_fg]="#e3e2e0"

# Title color for boxes
theme[title]="#e3e2e0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#bacbbf"

# Background and foreground color for selected item in processes box
theme[selected_bg]="#292a29"
theme[selected_fg]="#e3e2e0"

# Color of inactive/disabled text
theme[inactive_fg]="#464745"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c0c9c1"

# Box outline and divider line colors
theme[cpu_box]="#464745"
theme[mem_box]="#464745"
theme[net_box]="#464745"
theme[proc_box]="#464745"
theme[div_line]="#464745"

# Temperature graph colors
theme[temp_start]="#91918f"
theme[temp_mid]="#ffb4ab"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#91918f"
theme[cpu_mid]="#c7c6c4"
theme[cpu_end]="#bacbbf"

# Mem/Disk free meter
theme[free_start]="#91918f"
theme[free_mid]="#91918f"
theme[free_end]="#b4ccbd"

# Mem/Disk cached meter
theme[cached_start]="#91918f"
theme[cached_mid]="#91918f"
theme[cached_end]="#c0c9c1"

# Mem/Disk available meter
theme[available_start]="#91918f"
theme[available_mid]="#91918f"
theme[available_end]="#c7c6c4"

# Mem/Disk used meter
theme[used_start]="#91918f"
theme[used_mid]="#c7c6c4"
theme[used_end]="#bacbbf"

# Download graph colors
theme[download_start]="#91918f"
theme[download_mid]="#91918f"
theme[download_end]="#c0c9c1"

# Upload graph colors
theme[upload_start]="#91918f"
theme[upload_mid]="#91918f"
theme[upload_end]="#bacbbf"
