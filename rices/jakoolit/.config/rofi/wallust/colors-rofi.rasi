 /* wallust template - colors-rofi */

* {
active-background: #7CB8BB;
active-foreground: #DCDCCC;
normal-background: #3F3F3F;
normal-foreground: #DCDCCC;
urgent-background: #DC8CC3;
urgent-foreground: #DCDCCC;

alternate-active-background: #E0CF9F;
alternate-active-foreground: #DCDCCC;
alternate-normal-background: #3F3F3F;
alternate-normal-foreground: #DCDCCC;
alternate-urgent-background: #3F3F3F;
alternate-urgent-foreground: #DCDCCC;

selected-active-background: #7CB8BB;
selected-active-foreground: #000000;
selected-normal-background: #7CB8BB;
selected-normal-foreground: #000000;
selected-urgent-background: #7CB8BB;
selected-urgent-foreground: #000000;

background-color: #3F3F3F;
background: rgba(0,0,0,0.7);
foreground: #DCDCCC;
border-color: #7CB8BB;

color0: #3F3F3F;
color1: #DCA3A3;
color2: #5F7F5F;
color3: #E0CF9F;
color4: #7CB8BB;
color5: #DC8CC3;
color6: #93E0E3;
color7: #DCDCCC;
color8: #4F4F4F;
color9: #DCA3A3;
color10: #5F7F5F;
color11: #E0CF9F;
color12: #7CB8BB;
color13: #DC8CC3;
color14: #93E0E3;
color15: #FFFFFF;


}

