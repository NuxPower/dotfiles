 /* wallust template - colors-rofi */

* {
active-background: #003E8A;
active-foreground: #3E3E3E;
normal-background: #F4F4F4;
normal-foreground: #3E3E3E;
urgent-background: #E94691;
urgent-foreground: #3E3E3E;

alternate-active-background: #F8EEC7;
alternate-active-foreground: #3E3E3E;
alternate-normal-background: #F4F4F4;
alternate-normal-foreground: #3E3E3E;
alternate-urgent-background: #F4F4F4;
alternate-urgent-foreground: #3E3E3E;

selected-active-background: #003E8A;
selected-active-foreground: #000000;
selected-normal-background: #003E8A;
selected-normal-foreground: #000000;
selected-urgent-background: #003E8A;
selected-urgent-foreground: #000000;

background-color: #F4F4F4;
background: rgba(0,0,0,0.7);
foreground: #3E3E3E;
border-color: #003E8A;

color0: #FFFFFF;
color1: #970B16;
color2: #07962A;
color3: #F8EEC7;
color4: #003E8A;
color5: #E94691;
color6: #89D1EC;
color7: #3E3E3E;
color8: #666666;
color9: #970B16;
color10: #07962A;
color11: #F8EEC7;
color12: #003E8A;
color13: #E94691;
color14: #89D1EC;
color15: #3E3E3E;


}

