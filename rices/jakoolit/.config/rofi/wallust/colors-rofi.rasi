 /* wallust template - colors-rofi */

* {
active-background: #908774;
active-foreground: #ADA594;
normal-background: #292724;
normal-foreground: #ADA594;
urgent-background: #DDCBA6;
urgent-foreground: #ADA594;

alternate-active-background: #615C51;
alternate-active-foreground: #ADA594;
alternate-normal-background: #292724;
alternate-normal-foreground: #ADA594;
alternate-urgent-background: #292724;
alternate-urgent-foreground: #ADA594;

selected-active-background: #908774;
selected-active-foreground: #000000;
selected-normal-background: #908774;
selected-normal-foreground: #000000;
selected-urgent-background: #908774;
selected-urgent-foreground: #000000;

background-color: #292724;
background: rgba(0,0,0,0.7);
foreground: #ADA594;
border-color: #908774;

color0: #292724;
color1: #816F4B;
color2: #EC9255;
color3: #FFB380;
color4: #957E50;
color5: #EC9255;
color6: #AC8E53;
color7: #ADA594;
color8: #7E7767;
color9: #F29D63;
color10: #3D3A34;
color11: #615C51;
color12: #908774;
color13: #DDCBA6;
color14: #E58748;
color15: #F2EAD9;


}

