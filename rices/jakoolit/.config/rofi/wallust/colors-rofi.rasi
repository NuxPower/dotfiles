 /* wallust template - colors-rofi */

* {
active-background: #8F92AE;
active-foreground: #F5ECE9;
normal-background: #2D3131;
normal-foreground: #F5ECE9;
urgent-background: #D0BE68;
urgent-foreground: #F5ECE9;

alternate-active-background: #686953;
alternate-active-foreground: #F5ECE9;
alternate-normal-background: #2D3131;
alternate-normal-foreground: #F5ECE9;
alternate-urgent-background: #2D3131;
alternate-urgent-foreground: #F5ECE9;

selected-active-background: #8F92AE;
selected-active-foreground: #2D3131;
selected-normal-background: #8F92AE;
selected-normal-foreground: #2D3131;
selected-urgent-background: #686953;
