 /* wallust template - colors-rofi */

* {
active-background: #5E578C;
active-foreground: #B8CAD2;
normal-background: #181A1D;
normal-foreground: #B8CAD2;
urgent-background: #33677D;
urgent-foreground: #B8CAD2;

alternate-active-background: #2C596D;
alternate-active-foreground: #B8CAD2;
alternate-normal-background: #181A1D;
alternate-normal-foreground: #B8CAD2;
alternate-urgent-background: #181A1D;
alternate-urgent-foreground: #B8CAD2;

selected-active-background: #5E578C;
selected-active-foreground: #181A1D;
selected-normal-background: #5E578C;
selected-normal-foreground: #181A1D;
selected-urgent-background: #2C596D;
selected-urgent-foreground: #181A1D;

background-color: #181A1D;
background: rgba(0,0,0,0.7);
foreground: #B8CAD2;
border-color: #5E578C;

color0: #3E4144;
color1: #0A1823;
color2: #0B2332;
color3: #214352;
color4: #464169;
color5: #264D5E;
color6: #264D5E;
color7: #91ABB6;
color8: #65777F;
color9: #0E202E;
color10: #0E2F43;
color11: #2C596D;
