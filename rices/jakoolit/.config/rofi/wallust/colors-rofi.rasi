 /* wallust template - colors-rofi */

* {
active-background: #0000FF;
active-foreground: #000000;
normal-background: #FFFFFF;
normal-foreground: #000000;
urgent-background: #E500E5;
urgent-foreground: #000000;

alternate-active-background: #E5E500;
alternate-active-foreground: #000000;
alternate-normal-background: #FFFFFF;
alternate-normal-foreground: #000000;
alternate-urgent-background: #FFFFFF;
alternate-urgent-foreground: #000000;

selected-active-background: #0000FF;
selected-active-foreground: #000000;
selected-normal-background: #0000FF;
selected-normal-foreground: #000000;
selected-urgent-background: #0000FF;
selected-urgent-foreground: #000000;

background-color: #FFFFFF;
background: rgba(0,0,0,0.7);
foreground: #000000;
border-color: #0000FF;

color0: #000000;
color1: #990000;
color2: #00A600;
color3: #999900;
color4: #0000B2;
color5: #B200B2;
color6: #00A6B2;
color7: #BFBFBF;
color8: #666666;
color9: #E50000;
color10: #00D900;
color11: #E5E500;
color12: #0000FF;
color13: #E500E5;
color14: #00E5E5;
color15: #E5E5E5;


}

