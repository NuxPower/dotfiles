 /* wallust template - colors-rofi */

* {
active-background: #616C7B;
active-foreground: #ECE0DC;
normal-background: #191B20;
normal-foreground: #ECE0DC;
urgent-background: #A98F8A;
urgent-foreground: #ECE0DC;

alternate-active-background: #6B6369;
alternate-active-foreground: #ECE0DC;
alternate-normal-background: #191B20;
alternate-normal-foreground: #ECE0DC;
alternate-urgent-background: #191B20;
alternate-urgent-foreground: #ECE0DC;

selected-active-background: #616C7B;
selected-active-foreground: #191B20;
selected-normal-background: #616C7B;
selected-normal-foreground: #191B20;
selected-urgent-background: #6B6369;
selected-urgent-foreground: #191B20;

background-color: #191B20;
background: rgba(0,0,0,0.7);
foreground: #ECE0DC;
border-color: #616C7B;

color0: #404248;
color1: #1A2431;
color2: #222935;
