 /* wallust template - colors-rofi */

* {
active-background: #729FCF;
active-foreground: #FFFFFF;
normal-background: #300A24;
normal-foreground: #FFFFFF;
urgent-background: #AD7FA8;
urgent-foreground: #FFFFFF;

alternate-active-background: #FCE94F;
alternate-active-foreground: #FFFFFF;
alternate-normal-background: #300A24;
alternate-normal-foreground: #FFFFFF;
alternate-urgent-background: #300A24;
alternate-urgent-foreground: #FFFFFF;

selected-active-background: #729FCF;
selected-active-foreground: #000000;
selected-normal-background: #729FCF;
selected-normal-foreground: #000000;
selected-urgent-background: #729FCF;
selected-urgent-foreground: #000000;

background-color: #300A24;
background: rgba(0,0,0,0.7);
foreground: #FFFFFF;
border-color: #729FCF;

color0: #2E3436;
color1: #CC0000;
color2: #4E9A06;
color3: #C4A000;
color4: #3465A4;
color5: #75507B;
color6: #06989A;
color7: #D3D7CF;
color8: #555753;
color9: #EF2929;
color10: #8AE234;
color11: #FCE94F;
color12: #729FCF;
color13: #AD7FA8;
color14: #34E2E2;
color15: #EEEEEC;


}

