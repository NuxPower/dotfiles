 /* wallust template - colors-rofi */

* {
active-background: #9F8396;
active-foreground: #FEEFD5;
normal-background: #1F2124;
normal-foreground: #FEEFD5;
urgent-background: #EF9491;
urgent-foreground: #FEEFD5;

alternate-active-background: #538BA4;
alternate-active-foreground: #FEEFD5;
alternate-normal-background: #1F2124;
alternate-normal-foreground: #FEEFD5;
alternate-urgent-background: #1F2124;
alternate-urgent-foreground: #FEEFD5;

selected-active-background: #9F8396;
selected-active-foreground: #1F2124;
selected-normal-background: #9F8396;
selected-normal-foreground: #1F2124;
selected-urgent-background: #538BA4;
selected-urgent-foreground: #1F2124;

background-color: #1F2124;
background: rgba(0,0,0,0.7);
foreground: #FEEFD5;
border-color: #9F8396;

color0: #45474B;
color1: #121E2A;
color2: #2D4B5B;
color3: #3E687B;
color4: #776270;
color5: #B36F6D;
color6: #BD9D66;
color7: #F5E0BB;
color8: #AB9C83;
color9: #182938;
color10: #3B6479;
