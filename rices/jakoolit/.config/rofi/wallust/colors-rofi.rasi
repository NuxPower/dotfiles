 /* wallust template - colors-rofi */

* {
active-background: #517165;
active-foreground: #DBEDD0;
normal-background: #151718;
normal-foreground: #DBEDD0;
urgent-background: #5A906A;
urgent-foreground: #DBEDD0;

alternate-active-background: #1C333A;
alternate-active-foreground: #DBEDD0;
alternate-normal-background: #151718;
alternate-normal-foreground: #DBEDD0;
alternate-urgent-background: #151718;
alternate-urgent-foreground: #DBEDD0;

selected-active-background: #517165;
selected-active-foreground: #151718;
selected-normal-background: #517165;
selected-normal-foreground: #151718;
selected-urgent-background: #1C333A;
selected-urgent-foreground: #151718;

background-color: #151718;
background: rgba(0,0,0,0.7);
foreground: #DBEDD0;
border-color: #517165;

color0: #3C3E3F;
color1: #14252A;
color2: #15262C;
color3: #15262C;
color4: #3D554C;
color5: #436C4F;
color6: #72995B;
color7: #C3DDB4;
color8: #899B7E;
color9: #1B3138;
color10: #1C333A;
color11: #1C333A;
color12: #517165;
color13: #5A906A;
color14: #98CC7A;
color15: #C3DDB4;


}

