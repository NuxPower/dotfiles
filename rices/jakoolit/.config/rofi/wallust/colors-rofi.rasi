background-color: #2D3131;
background: rgba(0,0,0,0.7);
foreground: #F5ECE9;
border-color: #8F92AE;

color0: #525556;
color1: #192629;
color2: #393A4F;
color3: #4E4F3E;
color4: #6B6D82;
color5: #9C8E4E;
color6: #AA988F;
color7: #E8DCD7;
color8: #A29A96;
