{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window", "custom/recorder"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "clock", "tray", "custom/power"], 

    "hyprland/workspaces": {
        "format": "{name}"
    },
    "clock": {
        "format": "{:%H:%M} ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{}% "
    },
    "custom/recorder": {
        "format": "⏺️ REC",
        "interval": 1,
        "exec-if": "pgrep wf-recorder",
        "on-click": "pkill -SIGINT wf-recorder"
    },
    // Added this to match your other config
    "custom/power": {
        "format": "⏻",
        "on-click": "bash ~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    }
}
