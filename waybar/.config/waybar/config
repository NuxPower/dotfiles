{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["mpris"], 
    "modules-right": ["custom/recorder", "tray", "backlight", "pulseaudio", "network", "battery", "clock", "group/power"],

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "mpv": "🎵",
            "mpd": "📻"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "max-length": 45
    },

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 30
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "tooltip-format": "Brightness: {percent}%",
        "format-icons": ["", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "interval": 2
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "AC0",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "",
        "format-plugged": "",
        "tooltip-format": "{capacity}% - {timeTo}",
        "format-icons": ["", "", "", "", ""],
        "interval": 60
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "tooltip-format": "{volume}% {icon}",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "SSID: {essid}\nIP: {ipaddr}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "IP: {ipaddr}\nInterface: {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 10
    },

    "clock": {
        "format": "{:%H:%M  %Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "spacing": 10
    },

    "custom/recorder": {
        "format": "⏺️ REC",
        "interval": 5,
        "exec-if": "pgrep wf-recorder",
        "on-click": "pkill -SIGINT wf-recorder"
    },

    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power", // The main button
            "custom/quit",
            "custom/lock",
            "custom/reboot",
            "custom/shutdown"
        ]
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false
    },

    "custom/shutdown": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },

    "custom/reboot": {
        "format": "󰜉",
        "tooltip": false,
        "on-click": "systemctl reboot"
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip": false,
        "on-click": "hyprlock" // or swaylock
    },

    "custom/quit": {
        "format": "󰈆",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    }
}
